# Files that belong in the repository but not in the plugin ZIP.
#
# GitHub builds release source archives with `git archive`, which honours export-ignore. Everything
# listed here is therefore absent from the ZIP that lands on client sites, without being absent from
# the repository itself.

/.gitattributes         export-ignore
/.gitignore             export-ignore
/spec-ki-bildkennzeichnung.md  export-ignore
/test-site/             export-ignore
